{
  "expo": {
    "name": "Whisper",
    "slug": "whisper",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "whisper",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whisper.app",
      "infoPlist": {
        "UIBackgroundModes": []
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      }
    },
    "android": {
      "package": "com.whisper.app",
      "versionCode": 3,
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png"
      }
    },
    "plugins": [
      "./plugins/withArm64Only",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Whisper needs access to your photos so the model can look at them."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Whisper needs calendar access so the assistant can create and read events for you."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Whisper needs contacts access so the assistant can look up people when you ask."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Whisper uses your location only when you ask a location question."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Whisper needs media access so the assistant can search your photos and files when you ask.",
          "savePhotosPermission": "Whisper needs media access to save files when you ask."
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-blank.png",
          "imageWidth": 64
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
