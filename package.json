    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-thinking-orbs": "^0.2.1",
    "llama.rn": "^0.12.5",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-keyboard-controller": "^1.21.13",
